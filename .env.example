NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Leave payment credentials empty until ready.
SUPABASE_SECRET_KEY=
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
CRON_SECRET=

# Authorized club middleware only; never put tokens in NEXT_PUBLIC_ variables.
BOOKING_PROVIDERS_JSON={}

# Server-only Online Payamak credentials. OTP template must be approved by the provider.
ONLINEPAYAMAK_API_KEY=
ONLINEPAYAMAK_SENDER=
ONLINEPAYAMAK_OTP_TEMPLATE=
PHONE_AUTH_ENABLED=false
SUPABASE_SEND_SMS_HOOK_SECRET=
# Iranian mobile numbers, comma-separated; used for operational booking alerts.
ADMIN_NOTIFICATION_PHONES=

# Firebase web app values are public; the service-account credentials below are server-only.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
